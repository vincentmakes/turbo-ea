{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /d /c \"set TRAIL_INVOKED_AS=trail&&set DO_NOT_TRACK=1&&set TRAIL_HOME=%CD%\\.trail\\cache\\codex-home&&set PATH=%CD%\\node_modules\\.bin;%PATH%&&node .trail/hook.cjs session-start\"",
            "timeout": 10,
            "statusMessage": "Loading Turbo EA Trail notes"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/release-audits.cjs\"",
            "timeout": 10,
            "statusMessage": "Verifica entrambi gli audit prima del tag"
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /d /c \"set TRAIL_INVOKED_AS=trail&&set DO_NOT_TRACK=1&&set TRAIL_HOME=%CD%\\.trail\\cache\\codex-home&&set PATH=%CD%\\node_modules\\.bin;%PATH%&&node .trail/hook.cjs pre-edit\"",
            "timeout": 5,
            "statusMessage": "Loading Trail notes before the edit"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /d /c \"set TRAIL_INVOKED_AS=trail&&set DO_NOT_TRACK=1&&set TRAIL_HOME=%CD%\\.trail\\cache\\codex-home&&set PATH=%CD%\\node_modules\\.bin;%PATH%&&node .trail/hook.cjs pre-edit\"",
            "timeout": 5,
            "statusMessage": "Loading Trail notes before the command"
          },
          {
            "type": "command",
            "command": "cmd.exe /d /c \"set TRAIL_INVOKED_AS=trail&&set DO_NOT_TRACK=1&&set TRAIL_HOME=%CD%\\.trail\\cache\\codex-home&&set PATH=%CD%\\node_modules\\.bin;%PATH%&&node .trail/hook.cjs pre-bash\"",
            "timeout": 5,
            "statusMessage": "Checking the command with Trail"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/graphify-search.cjs\"",
            "timeout": 5,
            "statusMessage": "Graphify · Promemoria per le ricerche"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.turbo-security-check=!CLAUDE_PROJECT_DIR=. bash .claude/hooks/check-security-review.sh\" turbo-security-check",
            "timeout": 10,
            "statusMessage": "Verifica security review prima della PR"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /d /c \"set TRAIL_INVOKED_AS=trail&&set DO_NOT_TRACK=1&&set TRAIL_HOME=%CD%\\.trail\\cache\\codex-home&&set PATH=%CD%\\node_modules\\.bin;%PATH%&&node .trail/hook.cjs codex-post-bash\"",
            "timeout": 5,
            "statusMessage": "Recording the command result in Trail"
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /d /c \"set TRAIL_INVOKED_AS=trail&&set DO_NOT_TRACK=1&&set TRAIL_HOME=%CD%\\.trail\\cache\\codex-home&&set PATH=%CD%\\node_modules\\.bin;%PATH%&&node .trail/hook.cjs post-edit\"",
            "timeout": 10,
            "statusMessage": "Updating Trail context after the edit"
          }
        ]
      },
      {
        "matcher": "^mcp__codex_security__get_codex_security_completed_scan$",
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.turbo-security-mark=!CLAUDE_PROJECT_DIR=. bash .claude/hooks/mark-security-review.sh codex\" turbo-security-mark",
            "timeout": 10,
            "statusMessage": "Registra security review"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /d /c \"set TRAIL_INVOKED_AS=trail&&set DO_NOT_TRACK=1&&set TRAIL_HOME=%CD%\\.trail\\cache\\codex-home&&set PATH=%CD%\\node_modules\\.bin;%PATH%&&node .trail/hook.cjs prompt\"",
            "timeout": 15,
            "statusMessage": "Loading Trail context for the request"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /d /c \"set TRAIL_INVOKED_AS=trail&&set DO_NOT_TRACK=1&&set TRAIL_HOME=%CD%\\.trail\\cache\\codex-home&&set PATH=%CD%\\node_modules\\.bin;%PATH%&&node .trail/hook.cjs stop\"",
            "timeout": 10,
            "statusMessage": "Updating Trail at the end of the turn"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /d /c \"set TRAIL_INVOKED_AS=trail&&set DO_NOT_TRACK=1&&set TRAIL_HOME=%CD%\\.trail\\cache\\codex-home&&set PATH=%CD%\\node_modules\\.bin;%PATH%&&node .trail/hook.cjs session-end\"",
            "timeout": 3,
            "statusMessage": "Closing the Trail session"
          }
        ]
      }
    ]
  }
}
