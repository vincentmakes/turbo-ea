<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Collaboration"
                  targetNamespace="http://turbo-ea.io/bpmn"
                  exporter="Turbo EA"
                  exporterVersion="1.0">

  <bpmn:message id="Message_Request" name="Request" />
  <bpmn:message id="Message_Confirmation" name="Confirmation" />

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer" />
    <bpmn:participant id="Participant_Company" name="Company" processRef="Process_Company" />
    <bpmn:messageFlow id="MessageFlow_Request" name="Request" sourceRef="Task_SendRequest" targetRef="StartEvent_RequestReceived" />
    <bpmn:messageFlow id="MessageFlow_Confirmation" name="Confirmation" sourceRef="EndEvent_Confirmed" targetRef="Task_ReceiveConfirmation" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Customer" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Customer" name="Need identified">
      <bpmn:outgoing>Flow_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_SendRequest" name="Send request" messageRef="Message_Request">
      <bpmn:incoming>Flow_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ReceiveConfirmation" name="Receive confirmation" messageRef="Message_Confirmation">
      <bpmn:incoming>Flow_C2</bpmn:incoming>
      <bpmn:outgoing>Flow_C3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="EndEvent_Customer" name="Done">
      <bpmn:incoming>Flow_C3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="StartEvent_Customer" targetRef="Task_SendRequest" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_SendRequest" targetRef="Task_ReceiveConfirmation" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Task_ReceiveConfirmation" targetRef="EndEvent_Customer" />
  </bpmn:process>

  <bpmn:process id="Process_Company" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Company">
      <bpmn:lane id="Lane_Service" name="Service desk">
        <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandleRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Request received">
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Request" messageRef="Message_Request" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_HandleRequest" name="Handle request">
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_S2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1">
        <bpmn:targetRef>DataObjectReference_Request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:dataObjectReference id="DataObjectReference_Request" name="Request record" dataObjectRef="DataObject_Request" />
    <bpmn:dataObject id="DataObject_Request" />
    <bpmn:endEvent id="EndEvent_Confirmed" name="Confirmation sent">
      <bpmn:incoming>Flow_S2</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Confirmation" messageRef="Message_Confirmation" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S1" sourceRef="StartEvent_RequestReceived" targetRef="Task_HandleRequest" />
    <bpmn:sequenceFlow id="Flow_S2" sourceRef="Task_HandleRequest" targetRef="EndEvent_Confirmed" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_Customer_di" bpmnElement="Participant_Customer" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="700" height="180" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Customer_di" bpmnElement="StartEvent_Customer">
        <dc:Bounds x="232" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="212" y="175" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendRequest_di" bpmnElement="Task_SendRequest">
        <dc:Bounds x="320" y="110" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReceiveConfirmation_di" bpmnElement="Task_ReceiveConfirmation">
        <dc:Bounds x="620" y="110" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Customer_di" bpmnElement="EndEvent_Customer">
        <dc:Bounds x="792" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="797" y="175" width="27" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_C1_di" bpmnElement="Flow_C1">
        <di:waypoint x="268" y="150" />
        <di:waypoint x="320" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C2_di" bpmnElement="Flow_C2">
        <di:waypoint x="440" y="150" />
        <di:waypoint x="620" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C3_di" bpmnElement="Flow_C3">
        <di:waypoint x="740" y="150" />
        <di:waypoint x="792" y="150" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="Participant_Company_di" bpmnElement="Participant_Company" isHorizontal="true">
        <dc:Bounds x="160" y="300" width="700" height="220" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Service_di" bpmnElement="Lane_Service" isHorizontal="true">
        <dc:Bounds x="190" y="300" width="670" height="220" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_RequestReceived_di" bpmnElement="StartEvent_RequestReceived">
        <dc:Bounds x="362" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="338" y="415" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HandleRequest_di" bpmnElement="Task_HandleRequest">
        <dc:Bounds x="450" y="350" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObjectReference_Request_di" bpmnElement="DataObjectReference_Request">
        <dc:Bounds x="492" y="455" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="474" y="508" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Confirmed_di" bpmnElement="EndEvent_Confirmed">
        <dc:Bounds x="662" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="638" y="415" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_S1_di" bpmnElement="Flow_S1">
        <di:waypoint x="398" y="390" />
        <di:waypoint x="450" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S2_di" bpmnElement="Flow_S2">
        <di:waypoint x="570" y="390" />
        <di:waypoint x="662" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DataOutputAssociation_1_di" bpmnElement="DataOutputAssociation_1">
        <di:waypoint x="510" y="430" />
        <di:waypoint x="510" y="455" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MessageFlow_Request_di" bpmnElement="MessageFlow_Request">
        <di:waypoint x="380" y="190" />
        <di:waypoint x="380" y="372" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="390" y="270" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_Confirmation_di" bpmnElement="MessageFlow_Confirmation">
        <di:waypoint x="680" y="372" />
        <di:waypoint x="680" y="190" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="690" y="270" width="64" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
