{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.trail/hook.cjs\" session-start",
            "timeout": 8000
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "bettercallclaude@synced": false,
    "design@synced": false,
    "legal@synced": false,
    "productivity@synced": false,
    "cowork-plugin-management@synced": false
  }
}
